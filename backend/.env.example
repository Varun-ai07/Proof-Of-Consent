# Base Sepolia testnet (default)
RPC_URL=https://sepolia.base.org
# Must match blockchain/deployments/baseSepolia.json after deployment
CONTRACT_ADDRESS=0x764bF8b277a2c08B7A5B309Bb6853c5576C6f168
DEPLOYER_PRIVATE_KEY=your_hardhat_private_key

# LLM providers (primary → fallback chain)
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key
OPENROUTER_API_KEY=your_openrouter_key

# Agent Service
AGENT_SERVICE_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:5502

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_key

# Server
PORT=4000
